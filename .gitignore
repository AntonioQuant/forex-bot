# hardcodeadas. Lo que sí hay que excluir es cualquier archivo que
# contenga las claves REALES, si usas uno)
.env
*.key
*.pem

# Python
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/
venv/
.venv/

# Salidas de datos locales (pueden pesar mucho, no aportan al repo)
*.csv
*.log

# Sistema
.DS_Store
